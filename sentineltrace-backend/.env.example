# SentinelTrace backend environment configuration (Stage 2).
# Copy this file to .env and fill in real values locally. Never commit .env.

DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/sentineltrace

MODEL_A_PATH=artifacts/model_a/model_a_v1.pkl
MODEL_A_VERSION=model_a_v1

ENVIRONMENT=development

API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed frontend origins for CORS. Do not use "*"
# outside of quick local experimentation.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
